{
  "expo": {
    "name": "pi-agent",
    "slug": "pi-agent",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "piagent",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.vikashloomba.piagent",
      "icon": "./assets/expo.icon"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      "expo-secure-store",
      "expo-asset",
      "expo-widgets",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Pi Agent to attach photos from your library to messages.",
          "cameraPermission": "Allow Pi Agent to take photos to attach to messages.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Allow Pi Agent to keep agent work running in the background. Location updates are only used to keep the app alive while work runs.",
          "locationWhenInUsePermission": "Allow Pi Agent to keep agent work running in the background. Location updates are only used to keep the app alive while work runs."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
