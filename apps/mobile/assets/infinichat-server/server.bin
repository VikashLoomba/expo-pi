// server/models.ts
function createServerModels(credentials) {
  const models = createModels({ credentials, authContext: STORED_CREDENTIALS_ONLY });
  for (const provider2 of [
    openaiProvider(),
    anthropicProvider(),
    deepseekProvider(),
    googleProvider(),
    openrouterProvider(),
    xaiProvider()
  ]) {
    models.setProvider(provider2);
  }
  return models;
}

