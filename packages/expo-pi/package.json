{
  "name": "@automatalabs/expo-pi",
  "version": "0.1.0",
  "description": "Run Pi (@earendil-works/pi-agent-core and pi-ai) in Expo and React Native apps on iOS and Android.",
  "keywords": [
    "expo",
    "react-native",
    "metro",
    "pi",
    "pi-ai",
    "pi-agent",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "author": "Vikash Loomba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VikashLoomba/expo-pi.git",
    "directory": "packages/expo-pi"
  },
  "homepage": "https://github.com/VikashLoomba/expo-pi/tree/main/packages/expo-pi#readme",
  "bugs": {
    "url": "https://github.com/VikashLoomba/expo-pi/issues"
  },
  "type": "module",
  "exports": {
    "./metro": {
      "types": "./build/metro.d.cts",
      "default": "./build/metro.cjs"
    },
    "./crypto": {
      "types": "./build/polyfills/crypto.d.ts",
      "default": "./build/polyfills/crypto.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "!build/**/*.tsbuildinfo",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf build",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "expo-crypto": "~58.0.5"
  },
  "peerDependencies": {
    "expo": "~58.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "expo": "~58.0.6",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
