{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "lib": [
      "ES2024"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
